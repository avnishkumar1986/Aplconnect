DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apl_connect
DB_USERNAME=apl_connect_user
DB_PASSWORD=

SESSION_DRIVER=database
QUALITY_API_TOKEN=
PRODUCTION_API_TOKEN=
