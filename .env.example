APP_NAME="APL Connect"
APP_ENV=production
API_ENV=quality
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
